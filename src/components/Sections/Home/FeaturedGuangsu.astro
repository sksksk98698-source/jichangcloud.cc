---
import { Badge } from "@components/ui/badge";
import { PixelPanel } from "@components/ui/pixel-panel";

import { featuredAirport } from "@/data/airportsData";

const gsy = featuredAirport;
---

<section id="featured-guangsu" aria-labelledby="featured-guangsu-title" class="flex flex-col gap-4">
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-2">
      <span class="bg-success inline-block size-3 animate-pulse"></span>
      <span class="font-display text-success text-xs tracking-wider uppercase"
        >TOP 1 RANKED // GOLD OBSERVATORY</span
      >
    </div>
    <Badge pixel variant="secondary">2026 年度首推</Badge>
  </div>

  <PixelPanel
    class="border-success/80 bg-card shadow-pixel flex flex-col gap-6 border-4 p-6 md:p-8"
  >
    {/* 顶部标题区 */}
    <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
      <div>
        <div class="flex flex-wrap items-center gap-2">
          <h2
            id="featured-guangsu-title"
            class="font-display text-foreground text-2xl tracking-tight uppercase md:text-3xl"
          >
            1. {gsy.name}
          </h2>
          <Badge pixel variant="success">IEPL 专线旗舰</Badge>
          <span class="text-muted-foreground font-mono text-xs">2020年起稳定运营</span>
        </div>
        <p class="text-info mt-1 font-mono text-sm">
          {gsy.tagline} · 支持原生 IP 节点 · 单节点最高 2.5Gbps 带宽
        </p>
      </div>

      <div
        class="bg-accent/40 border-border flex flex-col items-start gap-1 border-2 p-3 md:items-end"
      >
        <span class="text-muted-foreground text-xs">专属新人优惠码</span>
        <div class="flex items-center gap-2">
          <code
            class="bg-primary/20 text-success border-success/40 border px-2 py-0.5 font-mono text-base font-bold tracking-wider"
          >
            {gsy.coupon}
          </code>
          <span class="text-muted-foreground text-[10px]">结账立享折扣</span>
        </div>
      </div>
    </div>

    {/* 晚高峰实测数据仪表盘 */}
    <div class="bg-background/80 border-border grid grid-cols-2 gap-3 border-2 p-4 sm:grid-cols-4">
      <div class="flex flex-col">
        <span class="text-muted-foreground font-mono text-[11px]">香港 IEPL 01</span>
        <span class="font-display text-success text-base">22ms</span>
        <span class="text-muted-foreground text-[10px]">下行 529 Mbps · 0% 丢包</span>
      </div>
      <div class="flex flex-col">
        <span class="text-muted-foreground font-mono text-[11px]">台湾 原生专线</span>
        <span class="font-display text-info text-base">41ms</span>
        <span class="text-muted-foreground text-[10px]">下行 114 Mbps · 4K秒开</span>
      </div>
      <div class="flex flex-col">
        <span class="text-muted-foreground font-mono text-[11px]">新加坡 高速节点</span>
        <span class="font-display text-success text-base">46ms</span>
        <span class="text-muted-foreground text-[10px]">下行 387 Mbps · 极低抖动</span>
      </div>
      <div class="flex flex-col">
        <span class="text-muted-foreground font-mono text-[11px]">日本 东京优化</span>
        <span class="font-display text-info text-base">57ms</span>
        <span class="text-muted-foreground text-[10px]">下行 135 Mbps · 全绿测试</span>
      </div>
    </div>

    {/* 解锁与能力矩阵 */}
    <div class="flex flex-wrap items-center gap-2 text-xs">
      <span class="text-muted-foreground font-mono">解锁能力:</span>
      <span class="bg-success/10 text-success border-success/30 border px-2 py-0.5 font-mono"
        >✓ ChatGPT (原生IP)</span
      >
      <span class="bg-success/10 text-success border-success/30 border px-2 py-0.5 font-mono"
        >✓ Claude (免降级)</span
      >
      <span class="bg-info/10 text-info border-info/30 border px-2 py-0.5 font-mono"
        >✓ Netflix 4K 全解</span
      >
      <span class="bg-info/10 text-info border-info/30 border px-2 py-0.5 font-mono">✓ Disney+</span
      >
      <span class="bg-info/10 text-info border-info/30 border px-2 py-0.5 font-mono"
        >✓ YouTube Premium</span
      >
      <span class="bg-accent/40 text-foreground border-border border px-2 py-0.5 font-mono"
        >✓ TikTok 直播加速</span
      >
    </div>

    {/* 套餐亮点 */}
    <div class="overflow-x-auto">
      <table class="w-full border-collapse text-left font-mono text-xs">
        <thead>
          <tr class="border-border text-muted-foreground border-b-2">
            <th class="py-2">核心套餐</th>
            <th class="py-2">周期/类型</th>
            <th class="py-2">价格</th>
            <th class="py-2">每月流量</th>
            <th class="py-2">定位推荐</th>
          </tr>
        </thead>
        <tbody class="divide-border/60 divide-y">
          <tr>
            <td class="text-foreground py-2 font-bold">致敬斯诺克147永久套餐</td>
            <td class="py-2">一次性</td>
            <td class="text-success py-2 font-bold">¥147</td>
            <td class="py-2">247GB 永久</td>
            <td class="text-muted-foreground py-2">永久有效不过期，轻度备用首选</td>
          </tr>
          <tr>
            <td class="text-foreground py-2 font-bold">轻量版 (性价比入门)</td>
            <td class="py-2">年付</td>
            <td class="text-success py-2 font-bold">¥99/年 (约¥8.25/月)</td>
            <td class="py-2">69GB/月</td>
            <td class="text-muted-foreground py-2">办公聊天、邮件资料、入门高性价比</td>
          </tr>
          <tr>
            <td class="text-foreground py-2 font-bold">极速版 (全 IPLC 专线)</td>
            <td class="py-2">月付</td>
            <td class="text-success py-2 font-bold">¥25/月</td>
            <td class="py-2">168GB/月</td>
            <td class="text-muted-foreground py-2">晚高峰 4K 视频、高品质跨境直连</td>
          </tr>
          <tr>
            <td class="text-foreground py-2 font-bold">定制版 (独享原生 IP)</td>
            <td class="py-2">月付</td>
            <td class="text-info py-2 font-bold">¥680/月</td>
            <td class="py-2">500GB/月</td>
            <td class="text-muted-foreground py-2">独立带宽部署、企业高隔离跨境业务</td>
          </tr>
        </tbody>
      </table>
    </div>

    {/* 实测测速大图 */}
    {
      gsy.speedtestImg && (
        <div class="border-border bg-background flex flex-col gap-2 border-2 p-2">
          <div class="text-muted-foreground flex items-center justify-between px-1 text-[11px]">
            <span class="font-mono">🔬 实验室节点晚高峰测速全图实录 (Speedtest 实测)</span>
            <span class="text-success font-mono">100% 真实截获无裁剪</span>
          </div>
          <a
            href={gsy.speedtestImg}
            target="_blank"
            rel="noopener noreferrer"
            class="block overflow-hidden transition-opacity hover:opacity-95"
          >
            <img
              src={gsy.speedtestImg}
              alt="光速云晚高峰测速实测图"
              class="max-h-96 w-full bg-black/40 object-contain"
              loading="lazy"
            />
          </a>
        </div>
      )
    }

    {/* 行动转化 CTA */}
    <div
      class="border-border flex flex-col items-center justify-between gap-4 border-t-2 pt-2 sm:flex-row"
    >
      <div class="text-muted-foreground text-xs">
        <span>* 支持支付宝 / 微信 / USDT · 客户端支持 Clash / 小火箭 / v2rayN 等</span>
      </div>

      <div class="flex w-full items-center gap-3 sm:w-auto">
        <a
          href={`/airports/${gsy.slug}/`}
          class="pixel-btn flex-1 px-4 py-3 text-center text-xs uppercase sm:flex-initial"
        >
          查看完整测评报告
        </a>
        <a
          href={gsy.registerUrl}
          target="_blank"
          rel="nofollow sponsored noopener"
          class="pixel-btn pixel-btn--blue shadow-pixel flex-1 px-6 py-3 text-center text-sm uppercase sm:flex-initial"
        >
          🚀 直通光速云官网 (优惠码 {gsy.coupon})
        </a>
      </div>
    </div>
  </PixelPanel>
</section>
