---
import HeroPanel from "@components/Sections/Global/HeroPanel.astro";
import { PixelPanel } from "@components/ui/pixel-panel";
import BaseLayout from "@layouts/BaseLayout.astro";

import { airportsData } from "@/data/airportsData";

const title = "42家机场品牌测评库 (2026 最新) — 机场cloud 测速实验室";
const description =
  "收录全网 42 家主流机场加速服务商详细数据。基于晚高峰真实测速、IEPL/IPLC专线、协议类型及流媒体/AI解锁能力全景展示。";
---

<BaseLayout title={title} description={description}>
  <div class="site-container flex flex-col gap-10 py-8 md:gap-12 md:py-12">
    <HeroPanel
      headingId="airports-heading"
      tagline="OBSERVATORY DATABASE"
      heading="42 家机场品牌库与实测矩阵"
      intro="全网 42 家主流梯子机场全量数据收录。包含晚高峰实测延迟、专线架构、流媒体与 ChatGPT 解锁能力，所有注册直达链接均经安全验证。"
    />

    {/* 42 品牌网格 */}
    <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
      {
        airportsData.map((item) => (
          <PixelPanel class="bg-card border-border hover:border-primary flex flex-col justify-between gap-4 border-2 p-6 transition-all">
            <div class="flex flex-col gap-3">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <span
                    class={`font-display border-border flex size-8 items-center justify-center border-2 text-sm ${item.rank === 1 ? "bg-primary font-bold text-black" : item.rank <= 3 ? "bg-info font-bold text-black" : "bg-muted text-foreground"}`}
                  >
                    #{item.rank}
                  </span>
                  <div>
                    <h2 class="font-display text-foreground text-lg tracking-tight uppercase">
                      {item.name}
                    </h2>
                    <span class="text-info font-mono text-[11px]">{item.lineType}</span>
                  </div>
                </div>
                <div class="text-right">
                  <span class="text-success block font-mono text-sm font-bold">{item.price}</span>
                  {item.coupon && (
                    <span class="text-primary bg-primary/10 border-primary/30 border px-1 font-mono text-[10px]">
                      码: {item.coupon}
                    </span>
                  )}
                </div>
              </div>

              <p class="text-muted-foreground text-xs leading-relaxed">{item.summary}</p>

              <div class="flex flex-wrap items-center gap-1.5 pt-1">
                {item.protocols.map((p) => (
                  <span class="bg-background border-border text-muted-foreground border px-1.5 py-0.5 font-mono text-[10px]">
                    {p}
                  </span>
                ))}
                {item.hasSpeedtest && (
                  <span class="bg-success/20 text-success border-success/40 border px-1.5 py-0.5 font-mono text-[10px]">
                    附晚高峰实测图
                  </span>
                )}
                {item.rank === 1 && (
                  <span class="bg-primary/20 text-primary border-primary/40 border px-1.5 py-0.5 font-mono text-[10px] font-bold">
                    ★ 年度首推
                  </span>
                )}
              </div>
            </div>

            <div class="border-border/60 flex items-center gap-3 border-t pt-3">
              <a
                href={`/airports/${item.slug}/`}
                class="pixel-btn flex-1 px-4 py-2.5 text-center text-xs"
              >
                测评详情报告
              </a>
              <a
                href={item.registerUrl}
                target="_blank"
                rel="nofollow sponsored noopener"
                class="pixel-btn pixel-btn--blue flex-1 px-4 py-2.5 text-center text-xs"
              >
                官网注册 ↗
              </a>
            </div>
          </PixelPanel>
        ))
      }
    </div>

    {/* 免责与赞助透明声明 */}
    <div
      class="bg-accent/40 border-border text-muted-foreground border-2 p-4 font-mono text-xs leading-relaxed"
    >
      <p class="text-foreground mb-1 font-bold">📢 数据来源与免责声明：</p>
      <p>
        1.
        本站所有机场测评数据均基于品牌官方资料、第三方实际节点测试以及网络实验室晚高峰监测日志整理。
      </p>
      <p>
        2. 链接包含官方推广参数（统一标注 rel="nofollow sponsored
        noopener"），通过链接注册可能为本站服务器维护提供赞助佣金，但绝不会影响您的支付价格与折扣优惠。
      </p>
      <p>
        3. 节点可用性与延迟受地区网络运营商影响，建议购买前优先选购小额月付周期实测满意后再续期。
      </p>
    </div>
  </div>
</BaseLayout>
