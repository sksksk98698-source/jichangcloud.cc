              <h3 class="font-display text-base text-foreground leading-snug">
                <a href={`/alerts/${art.slug}/`} class="hover:text-destructive transition-colors">
                  {art.title}
                </a>
              </h3>
              <p class="text-xs text-muted-foreground font-mono leading-relaxed">
                {art.excerpt}
              </p>
            </div>

            <div class="pt-3 border-t border-border flex items-center justify-between">
              <span class="text-[11px] font-mono text-info">
                分类：{art.categoryName}
              </span>
              <a href={`/alerts/${art.slug}/`} class="pixel-btn text-xs px-3 py-1.5">
                阅读风险深度解析 →
              </a>
            </div>
          </PixelPanel>
        ))}
      </div>
    </div>

