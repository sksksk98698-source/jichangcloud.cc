---
import { Badge } from "@components/ui/badge";
import { PixelPanel } from "@components/ui/pixel-panel";

const topics = [
  {
    title: "免费资源全景白皮书",
    tagline: "FREE CHANNELS & AUDIT",
    badge: "免费白嫖与避坑",
    variant: "success",
    href: "/free/",
    accent: "border-success",
    icon: "🎁",
    desc: "收录 Cloudflare WARP 免费无限流、高校 CERNET 学术专线与每日试用规则；深度审计公开代理的中间人嗅探与蜜罐风险。",
    stats: "万字支柱 · 4篇深度长尾 · 100%安全审计",
    linkText: "查阅免费资源白皮书 →",
  },
  {
    title: "梯子工具与诊断手册",
    tagline: "CLIENTS & NOC TOOLKIT",
    badge: "全平台客户端",
    variant: "info",
    href: "/tools/",
    accent: "border-info",
    icon: "🛠",
    desc: "覆盖 Windows/Mac (Clash Verge Rev TUN 模式)、iOS (小火箭配置)、软路由 PassWall 与 NextTrace 晚高峰 QoS 丢包诊断。",
    stats: "全平台覆盖 · 4大分类 · 零基础到进阶",
    linkText: "浏览工具诊断手册 →",
  },
  {
    title: "机场使用 100 问百科",
    tagline: "TROUBLESHOOTING BASE",
    badge: "疑难答疑库",
    variant: "warning",
    href: "/faq/",
    accent: "border-primary",
    icon: "❓",
    desc: "节点全部超时 (-1ms)、ChatGPT 1020 报错、Netflix 软封锁、国内微信打不开与 fake-ip 防 DNS 泄漏秒级自愈全解。",
    stats: "100问知识库 · 步骤化解决 · AI检索收割",
    linkText: "进入疑难排查百科 →",
  },
  {
    title: "机场防跑路风险预警",
    tagline: "EXIT-SCAM OBSERVATORY",
    badge: "风控雷达看板",
    variant: "destructive",
    href: "/alerts/",
    accent: "border-destructive",
    icon: "🚨",
    desc: "深度揭秘庞氏跑路鸡运作内幕：8 大致命前兆特征（突然骨折大促、TG全员禁言、工单失联）与 5 分钟受灾应急平替方案。",
    stats: "8大征兆模型 · 实时风险监测 · 避坑防御",
    linkText: "查看跑路预警白皮书 →",
  },
];
---

<section id="topic-matrix-section" aria-labelledby="topic-matrix-title" class="flex flex-col gap-6">
  <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-2 border-b-4 border-border pb-3">
    <div>
      <div class="flex items-center gap-2">
        <span class="font-display text-xs text-primary uppercase">TOPIC CLUSTERS</span>
        <Badge pixel variant="primary">四维知识矩阵</Badge>
      </div>
      <h2 id="topic-matrix-title" class="font-display text-2xl md:text-3xl text-foreground uppercase tracking-tight mt-1">
        核心专题知识矩阵与长尾导航
      </h2>
    </div>
    <span class="text-xs font-mono text-muted-foreground">
      以万字级支柱页 + 分类枢纽 + 独立长尾文章构筑的权威知识网络
    </span>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    {topics.map((t) => (
      <PixelPanel class={`p-6 flex flex-col justify-between gap-4 bg-card border-2 ${t.accent} hover:shadow-pixel transition-all`}>
        <div class="flex flex-col gap-3">
          <div class="flex items-center justify-between">
            <span class="text-xs font-mono text-muted-foreground">{t.tagline}</span>
            <span class="text-xs font-mono px-2 py-0.5 border border-border bg-background">
              {t.badge}
            </span>
          </div>

          <div class="flex items-center gap-2.5">
            <span class="text-2xl">{t.icon}</span>
            <h3 class="font-display text-lg text-foreground uppercase tracking-tight">
              <a href={t.href} class="hover:underline">
                {t.title}
              </a>
            </h3>
          </div>

          <p class="text-xs font-mono text-muted-foreground leading-relaxed">
            {t.desc}
          </p>
        </div>

        <div class="pt-3 border-t border-border flex items-center justify-between text-xs font-mono">
          <span class="text-[11px] text-muted-foreground">{t.stats}</span>
          <a href={t.href} class="pixel-btn text-xs px-3.5 py-1.5 font-bold">
            {t.linkText}
          </a>
        </div>
      </PixelPanel>
    ))}
  </div>
</section>
