---
import {
  Breadcrumb,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbPage,
  BreadcrumbSeparator,
} from "@components/ui/breadcrumb";
import { PixelPanel } from "@components/ui/pixel-panel";
import BaseLayout from "@layouts/BaseLayout.astro";

import { type AlertArticle, alertArticles } from "@/data/alertsData";

export function getStaticPaths() {
  return alertArticles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

interface Props {
  article: AlertArticle;
}

const { article } = Astro.props;

const pageTitle = `${article.title} — 机场cloud 跑路预警专题`;
const pageDescription = `${article.excerpt} 本文深入剖析 ${article.targetKeyword}，提供客观技术特征模型与应急平替自救方案。`;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <div class="site-container flex flex-col gap-8 py-8 md:gap-10 md:py-12">
    {/* 面包屑导航 */}
    <Breadcrumb class="font-mono text-xs">
      <BreadcrumbItem><BreadcrumbLink href="/">首页</BreadcrumbLink></BreadcrumbItem>
      <BreadcrumbSeparator />
      <BreadcrumbItem
        ><BreadcrumbLink href="/alerts/">跑路预警白皮书</BreadcrumbLink></BreadcrumbItem
      >
      <BreadcrumbSeparator />
      <BreadcrumbItem><BreadcrumbPage>{article.title}</BreadcrumbPage></BreadcrumbItem>
    </Breadcrumb>

    {/* 文章顶部信息卡 */}
    <PixelPanel
      class="bg-card border-destructive shadow-pixel flex flex-col gap-4 border-4 p-6 md:p-8"
    >
      <div class="flex flex-wrap items-center gap-2 font-mono text-xs">
        <span class="text-destructive font-bold">{article.badge}</span>
        <span class="text-muted-foreground"
          >· 发布于 {article.date} · 预计阅读时间 {article.readTime}</span
        >
        <span class="text-destructive border-destructive/40 bg-destructive/10 border px-2 py-0.5"
          >{article.riskLevel}</span
        >
      </div>

      <h1
        class="font-display text-foreground text-2xl leading-snug tracking-tight uppercase md:text-3xl"
      >
        {article.title}
      </h1>

      <p
        class="text-muted-foreground border-border border-t pt-3 font-mono text-xs leading-relaxed md:text-sm"
      >
        {article.excerpt}
      </p>
    </PixelPanel>

    {/* ⚡ Answer Block 极速首答 */}
    <PixelPanel class="bg-card border-destructive flex flex-col gap-3 border-2 p-6">
      <div class="flex items-center gap-2">
        <span class="text-destructive text-xl">⚡</span>
        <h2 class="font-display text-foreground text-base uppercase">
          Answer Block：核心风险定性与止损避坑结论
        </h2>
      </div>
      <p
        class="text-foreground bg-background border-border border p-4 font-mono text-xs leading-relaxed"
      >
        {article.answerBlock}
      </p>
    </PixelPanel>

    {/* 正文深度段落 */}
    <div class="flex flex-col gap-6">
      {
        article.content.map((paragraph) => (
          <PixelPanel class="bg-card border-border flex flex-col gap-3 border-2 p-6">
            <p class="text-muted-foreground font-mono text-xs leading-relaxed whitespace-pre-line md:text-sm">
              {paragraph}
            </p>
          </PixelPanel>
        ))
      }
    </div>

    {/* 常见问题 FAQ */}
    {
      article.faqs.length > 0 && (
        <PixelPanel class="bg-card border-border flex flex-col gap-4 border-2 p-6">
          <h2 class="font-display text-foreground flex items-center gap-2 text-lg uppercase">
            <span>❓</span> 风险防范答疑 FAQ
          </h2>
          <div class="flex flex-col gap-3 font-mono text-xs">
            {article.faqs.map((faq) => (
              <div class="bg-background border-border flex flex-col gap-1.5 border p-4">
                <span class="text-foreground font-bold">Q：{faq.q}</span>
                <span class="text-muted-foreground leading-relaxed">答：{faq.a}</span>
              </div>
            ))}
          </div>
        </PixelPanel>
      )
    }

    {/* 底部导航 */}
    <PixelPanel
      class="bg-accent/30 border-border flex flex-col items-center justify-between gap-4 border-2 p-6 sm:flex-row"
    >
      <div class="flex flex-col gap-1 font-mono text-xs">
        <span class="text-foreground font-bold">需要 5 分钟内快速接入稳定专线备用？</span>
        <span class="text-muted-foreground">查阅年度老牌专线首推服务商，月付仅需十余元。</span>
      </div>
      <div class="flex items-center gap-3">
        <a href="/alerts/" class="pixel-btn px-4 py-2 text-xs"> ← 返回预警白皮书 </a>
        <a
          href="/airports/guangshuyun/"
          class="pixel-btn pixel-btn--blue px-4 py-2 text-xs font-bold"
        >
          光速云专线测评 →
        </a>
      </div>
    </PixelPanel>
  </div>
</BaseLayout>
