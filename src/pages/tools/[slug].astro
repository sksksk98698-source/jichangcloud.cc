---
import {
  Breadcrumb,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbPage,
  BreadcrumbSeparator,
} from "@components/ui/breadcrumb";
import { PixelPanel } from "@components/ui/pixel-panel";
import BaseLayout from "@layouts/BaseLayout.astro";

import { type ToolArticle, toolsArticles } from "@/data/toolsData";

export function getStaticPaths() {
  return toolsArticles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

interface Props {
  article: ToolArticle;
}

const { article } = Astro.props;

const pageTitle = `${article.title} — 机场cloud 梯子工具库`;
const pageDescription = `${article.excerpt} 本篇深度指南聚焦 ${article.targetKeyword}，覆盖底层原理、配置步骤与报错避坑自检。`;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <div class="site-container flex flex-col gap-8 py-8 md:gap-10 md:py-12">
    {/* 面包屑导航 */}
    <Breadcrumb class="font-mono text-xs">
      <BreadcrumbItem><BreadcrumbLink href="/">首页</BreadcrumbLink></BreadcrumbItem>
      <BreadcrumbSeparator />
      <BreadcrumbItem><BreadcrumbLink href="/tools/">梯子工具手册</BreadcrumbLink></BreadcrumbItem>
      <BreadcrumbSeparator />
      <BreadcrumbItem><BreadcrumbPage>{article.title}</BreadcrumbPage></BreadcrumbItem>
    </Breadcrumb>

    {/* 文章顶部信息卡 */}
    <PixelPanel class="bg-card border-info/80 shadow-pixel flex flex-col gap-4 border-4 p-6 md:p-8">
      <div class="flex flex-wrap items-center gap-2 font-mono text-xs">
        <span class="text-info font-bold">{article.badge}</span>
        <span class="text-muted-foreground"
          >· 发布于 {article.date} · 适配平台: {article.platform}</span
        >
        <span class="text-success border-success/40 bg-success/10 border px-2 py-0.5"
          >{article.categoryName}</span
        >
      </div>

      <h1
        class="font-display text-foreground text-2xl leading-snug tracking-tight uppercase md:text-3xl"
      >
        {article.title}
      </h1>

      <p
        class="text-muted-foreground border-border border-t pt-3 font-mono text-xs leading-relaxed md:text-sm"
      >
        {article.excerpt}
      </p>
    </PixelPanel>

    {/* ⚡ Answer Block 极速首答 */}
    <PixelPanel class="bg-card border-info/80 flex flex-col gap-3 border-2 p-6">
      <div class="flex items-center gap-2">
        <span class="text-info text-xl">⚡</span>
        <h2 class="font-display text-foreground text-base uppercase">
          Answer Block：技术原理与实操要点直答
        </h2>
      </div>
      <p
        class="text-foreground bg-background border-border border p-4 font-mono text-xs leading-relaxed"
      >
        {article.answerBlock}
      </p>
    </PixelPanel>

    {/* 正文深度段落 */}
    <div class="flex flex-col gap-6">
      {
        article.content.map((paragraph) => (
          <PixelPanel class="bg-card border-border flex flex-col gap-3 border-2 p-6">
            <p class="text-muted-foreground font-mono text-xs leading-relaxed whitespace-pre-line md:text-sm">
              {paragraph}
            </p>
          </PixelPanel>
        ))
      }
    </div>

    {/* 常见问题 FAQ */}
    {
      article.faqs.length > 0 && (
        <PixelPanel class="bg-card border-border flex flex-col gap-4 border-2 p-6">
          <h2 class="font-display text-foreground flex items-center gap-2 text-lg uppercase">
            <span>❓</span> 常见配置报错 FAQ
          </h2>
          <div class="flex flex-col gap-3 font-mono text-xs">
            {article.faqs.map((faq) => (
              <div class="bg-background border-border flex flex-col gap-1.5 border p-4">
                <span class="text-foreground font-bold">Q：{faq.q}</span>
                <span class="text-muted-foreground leading-relaxed">答：{faq.a}</span>
              </div>
            ))}
          </div>
        </PixelPanel>
      )
    }

    {/* 底部导航 */}
    <PixelPanel
      class="bg-accent/30 border-border flex flex-col items-center justify-between gap-4 border-2 p-6 sm:flex-row"
    >
      <div class="flex flex-col gap-1 font-mono text-xs">
        <span class="text-foreground font-bold">需要获取更多官方纯净客户端？</span>
        <span class="text-muted-foreground">前往本站全平台客户端工具中心获取官方校验安装包。</span>
      </div>
      <div class="flex items-center gap-3">
        <a href="/tools/" class="pixel-btn px-4 py-2 text-xs"> ← 返回工具手册 </a>
        <a href="/clients/" class="pixel-btn pixel-btn--blue px-4 py-2 text-xs font-bold">
          客户端下载库 →
        </a>
      </div>
    </PixelPanel>
  </div>
</BaseLayout>
