---
import AirportRankings from "@components/Sections/Home/AirportRankings.astro";
import ClientsSection from "@components/Sections/Home/ClientsSection.astro";
import Contact from "@components/Sections/Home/Contact.astro";
import FeaturedGuangsu from "@components/Sections/Home/FeaturedGuangsu.astro";
import Hero from "@components/Sections/Home/Hero.astro";
import HomeFaq from "@components/Sections/Home/HomeFaq.astro";
import LatestPosts from "@components/Sections/Home/LatestPosts.astro";
import SpeedtestSection from "@components/Sections/Home/SpeedtestSection.astro";
import Stats from "@components/Sections/Home/Stats.astro";
import TopicMatrixSection from "@components/Sections/Home/TopicMatrixSection.astro";
import siteData from "@config/siteData.json";
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout title={siteData.title} description={siteData.description}>
  <div class="site-container flex flex-col gap-10 py-8 md:gap-14 md:py-12">
    <Hero />
    <Stats />
    <FeaturedGuangsu />
    <AirportRankings />
    <TopicMatrixSection />
    <SpeedtestSection />
    <ClientsSection />
    <HomeFaq />
    <LatestPosts />
    <Contact />
  </div>
</BaseLayout>
