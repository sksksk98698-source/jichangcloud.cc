---
import { Badge } from "@components/ui/badge";
import { PixelPanel } from "@components/ui/pixel-panel";

import { proxyClients } from "@/data/clientsData";

const popularClients = proxyClients.filter((c) => c.isPopular).slice(0, 6);
---

<section id="clients-section" aria-labelledby="clients-title" class="flex flex-col gap-6">
  <div
    class="border-border flex flex-col gap-2 border-b-4 pb-3 sm:flex-row sm:items-end sm:justify-between"
  >
    <div>
      <div class="flex items-center gap-2">
        <span class="font-display text-secondary text-xs uppercase">CLIENT ECOSYSTEM</span>
        <Badge pixel variant="secondary">全平台覆盖</Badge>
      </div>
      <h2
        id="clients-title"
        class="font-display text-foreground mt-1 text-2xl tracking-tight uppercase md:text-3xl"
      >
        主流翻墙代理客户端大全与配置
      </h2>
    </div>
    <a href="/clients/" class="text-success font-mono text-xs hover:underline">
      查看全系统下载与教程 →
    </a>
  </div>

  <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
    {
      popularClients.map((client) => (
        <PixelPanel class="bg-card border-border flex flex-col justify-between gap-3 border-2 p-5">
          <div class="flex flex-col gap-2">
            <div class="flex items-center justify-between">
              <h3 class="font-display text-foreground text-base uppercase">{client.name}</h3>
              <span class="bg-accent border-border border px-2 py-0.5 font-mono text-[10px]">
                {client.osLabel}
              </span>
            </div>
            <span class="text-info font-mono text-xs">{client.kernel}</span>
            <p class="text-muted-foreground line-clamp-2 text-xs">{client.features}</p>
          </div>

          <div class="border-border/60 flex items-center justify-between border-t pt-2">
            <span class="text-muted-foreground text-[10px]">开源/官方正版</span>
            <a
              href={client.downloadUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-success font-mono text-xs font-bold hover:underline"
            >
              获取下载 ↗
            </a>
          </div>
        </PixelPanel>
      ))
    }
  </div>
</section>
