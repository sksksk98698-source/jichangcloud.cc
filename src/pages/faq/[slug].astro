---
import {
  Breadcrumb,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbPage,
  BreadcrumbSeparator,
} from "@components/ui/breadcrumb";
import { PixelPanel } from "@components/ui/pixel-panel";
import BaseLayout from "@layouts/BaseLayout.astro";

import { type FaqArticle, faqArticles } from "@/data/faqData";

export function getStaticPaths() {
  return faqArticles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

interface Props {
  article: FaqArticle;
}

const { article } = Astro.props;

const pageTitle = `${article.title} — 机场cloud 疑难答疑库`;
const pageDescription = `${article.excerpt} 本篇深度故障排查聚焦 ${article.targetKeyword}，手把手提供实操诊断流程与秒级修复方案。`;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <div class="site-container flex flex-col gap-8 py-8 md:gap-10 md:py-12">
    {/* 面包屑导航 */}
    <Breadcrumb class="font-mono text-xs">
      <BreadcrumbItem><BreadcrumbLink href="/">首页</BreadcrumbLink></BreadcrumbItem>
      <BreadcrumbSeparator />
      <BreadcrumbItem><BreadcrumbLink href="/faq/">疑难排查百科</BreadcrumbLink></BreadcrumbItem>
      <BreadcrumbSeparator />
      <BreadcrumbItem><BreadcrumbPage>{article.title}</BreadcrumbPage></BreadcrumbItem>
    </Breadcrumb>

    {/* 文章顶部信息卡 */}
    <PixelPanel
      class="bg-card border-primary/80 shadow-pixel flex flex-col gap-4 border-4 p-6 md:p-8"
    >
      <div class="flex flex-wrap items-center gap-2 font-mono text-xs">
        <span class="text-primary font-bold">{article.badge}</span>
        <span class="text-muted-foreground"
          >· 发布于 {article.date} · 预计阅读时间 {article.readTime}</span
        >
        <span class="text-success border-success/40 bg-success/10 border px-2 py-0.5"
          >{article.categoryName}</span
        >
      </div>

      <h1
        class="font-display text-foreground text-2xl leading-snug tracking-tight uppercase md:text-3xl"
      >
        {article.title}
      </h1>

      <p
        class="text-muted-foreground border-border border-t pt-3 font-mono text-xs leading-relaxed md:text-sm"
      >
        {article.excerpt}
      </p>
    </PixelPanel>

    {/* ⚡ Answer Block 极速首答 */}
    <PixelPanel class="bg-card border-primary/80 flex flex-col gap-3 border-2 p-6">
      <div class="flex items-center gap-2">
        <span class="text-primary text-xl">⚡</span>
        <h2 class="font-display text-foreground text-base uppercase">
          Answer Block：核心根源与秒级自愈结论
        </h2>
      </div>
      <p
        class="text-foreground bg-background border-border border p-4 font-mono text-xs leading-relaxed"
      >
        {article.answerBlock}
      </p>
    </PixelPanel>

    {/* 正文深度排查步骤 */}
    <div class="flex flex-col gap-6">
      {
        article.content.map((paragraph) => (
          <PixelPanel class="bg-card border-border flex flex-col gap-3 border-2 p-6">
            <p class="text-muted-foreground font-mono text-xs leading-relaxed whitespace-pre-line md:text-sm">
              {paragraph}
            </p>
          </PixelPanel>
        ))
      }
    </div>

    {/* 常见问题 FAQ */}
    {
      article.faqs.length > 0 && (
        <PixelPanel class="bg-card border-border flex flex-col gap-4 border-2 p-6">
          <h2 class="font-display text-foreground flex items-center gap-2 text-lg uppercase">
            <span>❓</span> 补充长尾答疑 FAQ
          </h2>
          <div class="flex flex-col gap-3 font-mono text-xs">
            {article.faqs.map((faq) => (
              <div class="bg-background border-border flex flex-col gap-1.5 border p-4">
                <span class="text-foreground font-bold">Q：{faq.q}</span>
                <span class="text-muted-foreground leading-relaxed">答：{faq.a}</span>
              </div>
            ))}
          </div>
        </PixelPanel>
      )
    }

    {/* 底部导航 */}
    <PixelPanel
      class="bg-accent/30 border-border flex flex-col items-center justify-between gap-4 border-2 p-6 sm:flex-row"
    >
      <div class="flex flex-col gap-1 font-mono text-xs">
        <span class="text-foreground font-bold">遇到其他难以解决的复杂网络报错？</span>
        <span class="text-muted-foreground">前往百科总览或参考本站全套客户端配置教程。</span>
      </div>
      <div class="flex items-center gap-3">
        <a href="/faq/" class="pixel-btn px-4 py-2 text-xs"> ← 返回疑难百科 </a>
        <a
          href="/blog/mastering-terminal-workflows/"
          class="pixel-btn pixel-btn--blue px-4 py-2 text-xs font-bold"
        >
          客户端避坑全教程 →
        </a>
      </div>
    </PixelPanel>
  </div>
</BaseLayout>
