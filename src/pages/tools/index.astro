---
import HeroPanel from "@components/Sections/Global/HeroPanel.astro";
import { Badge } from "@components/ui/badge";
import { Breadcrumb, BreadcrumbItem, BreadcrumbLink, BreadcrumbPage, BreadcrumbSeparator } from "@components/ui/breadcrumb";
import { PixelPanel } from "@components/ui/pixel-panel";
import { toolsArticles } from "@/data/toolsData";
import BaseLayout from "@layouts/BaseLayout.astro";

const pageTitle = "2026 科学上网客户端与网络诊断工具完全手册：全平台选型、配置实操与避坑指南 — 机场cloud";
const pageDescription = "全网权威专著级科学上网客户端与专业网络诊断工具手册。深度对比 Clash Verge Rev、Sing-box、Shadowrocket、Surge、v2rayN、PassWall 等全平台软件架构、内核演进、TUN 虚拟网卡配置与防钓鱼安全准则。";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <div class="site-container flex flex-col gap-10 py-8 md:gap-12 md:py-12">
    {/* 面包屑导航 */}
    <Breadcrumb class="text-xs font-mono">
      <BreadcrumbItem><BreadcrumbLink href="/">首页</BreadcrumbLink></BreadcrumbItem>
      <BreadcrumbSeparator />
      <BreadcrumbItem><BreadcrumbPage>梯子工具完全手册</BreadcrumbPage></BreadcrumbItem>
    </Breadcrumb>

    {/* 顶部 Pillar 看板 */}
    <HeroPanel
      headingId="tools-heading"
      tagline="PROXY CLIENTS & NOC TOOLKIT MONOGRAPH"
      heading="2026 科学上网客户端与网络工具完全手册"
      intro="全平台翻墙客户端全景工具库与专著级技术手册。深度解析桌面端、移动端、软路由网关与网络实验室抓包诊断利器。从底层内核分化、TUN 虚拟网卡接管、加密握手开销，到防钓鱼防投毒准则，助你构建无懈可击的高性能网络环境。"
    />

    {/* 快速页内锚点导航目录 (TOC) */}
    <PixelPanel class="p-5 bg-card border-2 border-border text-xs font-mono flex flex-col gap-3">
      <span class="font-bold text-foreground flex items-center gap-2">
        <span>📑</span> 目录导航 (Table of Contents)
      </span>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-2 text-muted-foreground">
        <a href="#quick-answer" class="hover:text-primary transition-colors">1. 极速选型决策</a>
        <a href="#matrix-table" class="hover:text-primary transition-colors">2. 全平台核心对比表</a>
        <a href="#kernel-evolution" class="hover:text-primary transition-colors">3. 代理内核演进史</a>
        <a href="#desktop-deep-dive" class="hover:text-primary transition-colors">4. 桌面端深度拆解</a>
        <a href="#mobile-deep-dive" class="hover:text-primary transition-colors">5. 移动端终极配置</a>
        <a href="#router-gateway" class="hover:text-primary transition-colors">6. 软路由全屋透明代理</a>
        <a href="#diagnostics-toolkit" class="hover:text-primary transition-colors">7. 实验室排障工具箱</a>
        <a href="#security-audit" class="hover:text-primary transition-colors">8. 防钓鱼安全红线</a>
        <a href="#decision-tree" class="hover:text-primary transition-colors">9. 多场景决策树</a>
        <a href="#faq-section" class="hover:text-primary transition-colors">10. 疑难问题 FAQ</a>
        <a href="#cluster-articles" class="hover:text-primary transition-colors">11. 长尾精选实操</a>
      </div>
    </PixelPanel>

    {/* ========================================================= */}
    {/* 1. ⚡ Answer Block：跨平台工具选型极速决策指南 */}
    {/* ========================================================= */}
    <section id="quick-answer" class="flex flex-col gap-4">
      <PixelPanel class="p-6 md:p-8 bg-card border-4 border-info/80 flex flex-col gap-5 shadow-pixel">
        <div class="flex items-center gap-2 border-b border-border pb-3">
          <span class="text-info text-xl">⚡</span>
          <h2 class="font-display text-lg text-foreground uppercase">
            Answer Block：2026 跨平台翻墙工具黄金推荐组合与速查
          </h2>
        </div>

        <p class="text-xs font-mono text-muted-foreground leading-relaxed">
          针对绝大多数希望“零折腾、高稳定、全流量代理且低功耗”的用户，我们在实测了全网三十余款客户端并跟踪其代码仓库活跃度后，给出以下开门见山的权威选型结论：
        </p>

        <div class="grid grid-cols-1 md:grid-cols-4 gap-3.5 text-xs font-mono leading-relaxed">
          <div class="bg-background border-2 border-border p-4 flex flex-col gap-2">
            <div class="flex items-center justify-between">
              <span class="text-success font-bold text-sm">💻 Windows 首选</span>
              <span class="text-[10px] bg-success/10 text-success border border-success/30 px-1.5 py-0.5 font-bold">开源标杆</span>
            </div>
            <span class="text-foreground font-bold text-base">Clash Verge Rev</span>
            <p class="text-muted-foreground text-[11px]">
              内置 <strong>Mihomo (Clash Meta)</strong> 商业级高性能内核。底层采用现代 Rust/Tauri 框架，彻底摒弃旧版 Electron 的臃肿内存占用。支持一键部署 Windows 过滤平台服务（Service Mode）与 <strong>TUN 虚拟网卡</strong>，实现终端命令行、Docker 容器、Steam 外服游戏与全部桌面浏览器的零死角接管。
            </p>
          </div>

          <div class="bg-background border-2 border-border p-4 flex flex-col gap-2">
            <div class="flex items-center justify-between">
              <span class="text-info font-bold text-sm">🍏 macOS 首选</span>
              <span class="text-[10px] bg-info/10 text-info border border-info/30 px-1.5 py-0.5 font-bold">原生适配</span>
            </div>
            <span class="text-foreground font-bold text-base">Clash Verge / Surge</span>
            <p class="text-muted-foreground text-[11px]">
              日常推荐 Clash Verge Rev（原生深度适配 Apple Silicon M 系列芯片架构，休眠唤醒不掉线，系统内存常驻仅 45MB 左右）；对于具备高级网络调试需求、愿意承担高昂买断费用的开发者，可直接选择业界天花板级调试神器 <strong>Surge Mac</strong>。
            </p>
          </div>

          <div class="bg-background border-2 border-border p-4 flex flex-col gap-2">
            <div class="flex items-center justify-between">
              <span class="text-primary font-bold text-sm">📱 iOS 首选</span>
              <span class="text-[10px] bg-primary/10 text-primary border border-primary/30 px-1.5 py-0.5 font-bold">装机必备</span>
            </div>
            <span class="text-foreground font-bold text-base">Shadowrocket (小火箭)</span>
            <p class="text-muted-foreground text-[11px]">
              外区 App Store 一次性买断仅需 <strong>$2.99</strong>。原生基于 iOS Network Extension 框架编写，支持从古老 Shadowsocks 到现代化 VLESS-Reality、Hysteria 2 全套协议。ACL 分流规则成熟可靠，锁屏待机功耗极低，是当之无愧的 iOS 综合性价比王者。
            </p>
          </div>

          <div class="bg-background border-2 border-border p-4 flex flex-col gap-2">
            <div class="flex items-center justify-between">
              <span class="text-accent-foreground font-bold text-sm">🤖 Android 首选</span>
              <span class="text-[10px] bg-accent/20 text-accent-foreground border border-border px-1.5 py-0.5 font-bold">纯净无广</span>
            </div>
            <span class="text-foreground font-bold text-base">Clash Meta (Flclash)</span>
            <p class="text-muted-foreground text-[11px]">
              开源现代 Flutter UI 客户端。分应用代理机制完善，国内应用（微信、支付宝、网银 App）全自动白名单直连，彻底杜绝电量偷跑与国内服务定位异常。
            </p>
          </div>
        </div>

        <div class="bg-accent/40 border border-border p-4 text-xs font-mono flex flex-col sm:flex-row items-center justify-between gap-3">
          <span class="text-muted-foreground">
            💡 <strong>基础设施底层逻辑</strong>：客户端只是一辆跑车，底层节点是高速公路。无论客户端调优多么完美，若节点走普通公网出口依然会在晚高峰遭遇 30% 以上的恶性丢包。
          </span>
          <a href="/airports/guangshuyun/" class="pixel-btn pixel-btn--blue text-xs px-4 py-2 font-bold whitespace-nowrap">
            查看光速云评测 (专属 8 折码 AMM) →
          </a>
        </div>
      </PixelPanel>
    </section>

    {/* ========================================================= */}
    {/* 2. 📊 全平台主流代理客户端核心特性全景对比表 */}
    {/* ========================================================= */}
    <section id="matrix-table" class="flex flex-col gap-4">
      <PixelPanel class="p-6 md:p-8 bg-card border-2 border-border flex flex-col gap-5">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 border-b border-border pb-3">
          <div>
            <h2 class="font-display text-lg text-foreground uppercase">
              主流翻墙代理客户端全景硬核指标横评
            </h2>
            <span class="text-xs font-mono text-muted-foreground">MULTI-PLATFORM BENCHMARK SPECIFICATIONS</span>
          </div>
          <span class="text-xs font-mono text-success">数据已于 2026 Q4 核实校验</span>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs font-mono border-collapse min-w-[750px]">
            <thead>
              <tr class="border-b-2 border-border text-muted-foreground bg-accent/30">
                <th class="py-3 px-3">客户端名称</th>
                <th class="py-3 px-3">支持操作系统</th>
                <th class="py-3 px-3">底层开发框架/内核</th>
                <th class="py-3 px-3">支持协议全集</th>
                <th class="py-3 px-3">TUN 虚拟网卡</th>
                <th class="py-3 px-3">典型内存占用</th>
                <th class="py-3 px-3">上手门槛</th>
                <th class="py-3 px-3">商业模式</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border/60">
              <tr class="hover:bg-accent/20">
                <td class="py-3 px-3 font-bold text-foreground">Clash Verge Rev</td>
                <td class="py-3 px-3 text-info">Windows / macOS / Linux</td>
                <td class="py-3 px-3 text-muted-foreground">Tauri (Rust) + Mihomo 内核</td>
                <td class="py-3 px-3 text-muted-foreground">SS, Trojan, VLESS, Hysteria 2, TUIC</td>
                <td class="py-3 px-3 text-success font-bold">原生内置 (WFP驱动)</td>
                <td class="py-3 px-3 text-foreground font-bold">45MB ~ 85MB</td>
                <td class="py-3 px-3 text-success">★☆☆ (入门友好)</td>
                <td class="py-3 px-3 text-success font-bold">开源免费</td>
              </tr>
              <tr class="hover:bg-accent/20">
                <td class="py-3 px-3 font-bold text-foreground">Shadowrocket (小火箭)</td>
                <td class="py-3 px-3 text-info">iOS / iPadOS / macOS</td>
                <td class="py-3 px-3 text-muted-foreground">Swift + 原生 Network Extension</td>
                <td class="py-3 px-3 text-muted-foreground">全协议通用支持 (含 VLESS Reality)</td>
                <td class="py-3 px-3 text-success font-bold">系统原生 VPN 虚拟网卡</td>
                <td class="py-3 px-3 text-foreground font-bold">18MB ~ 35MB (极度轻巧)</td>
                <td class="py-3 px-3 text-success">★☆☆ (一键订阅)</td>
                <td class="py-3 px-3 text-info">$2.99 买断</td>
              </tr>
              <tr class="hover:bg-accent/20">
                <td class="py-3 px-3 font-bold text-foreground">Sing-box</td>
                <td class="py-3 px-3 text-info">全平台跨平台支持</td>
                <td class="py-3 px-3 text-muted-foreground">Go 语言独立高性能重构核心</td>
                <td class="py-3 px-3 text-muted-foreground">全套下一代前沿协议</td>
                <td class="py-3 px-3 text-success font-bold">内核级多平台 TUN 支持</td>
                <td class="py-3 px-3 text-foreground font-bold">35MB ~ 65MB</td>
                <td class="py-3 px-3 text-primary">★★★ (适合进阶玩家)</td>
                <td class="py-3 px-3 text-success font-bold">开源免费</td>
              </tr>
              <tr class="hover:bg-accent/20">
                <td class="py-3 px-3 font-bold text-foreground">Surge (iOS / Mac)</td>
                <td class="py-3 px-3 text-info">iOS / macOS 专属生态</td>
                <td class="py-3 px-3 text-muted-foreground">Objective-C/Swift 深度闭源引擎</td>
                <td class="py-3 px-3 text-muted-foreground">SS, Trojan, Snell, HTTP/SOCKS5</td>
                <td class="py-3 px-3 text-success font-bold">增强模式 (顶级性能)</td>
                <td class="py-3 px-3 text-foreground font-bold">30MB ~ 60MB</td>
                <td class="py-3 px-3 text-primary">★★☆ (网络工程师标配)</td>
                <td class="py-3 px-3 text-primary">$49.99 起 (高昂年付)</td>
              </tr>
              <tr class="hover:bg-accent/20">
                <td class="py-3 px-3 font-bold text-foreground">v2rayN</td>
                <td class="py-3 px-3 text-info">Windows 专属</td>
                <td class="py-3 px-3 text-muted-foreground">C# (.NET 8) + 多核心外挂</td>
                <td class="py-3 px-3 text-muted-foreground">Xray, Sing-box, V2Ray 核心外挂</td>
                <td class="py-3 px-3 text-info">支持 (依靠 sing-box tun)</td>
                <td class="py-3 px-3 text-foreground font-bold">90MB ~ 160MB</td>
                <td class="py-3 px-3 text-info">★★☆ (界面传统偏极客)</td>
                <td class="py-3 px-3 text-success font-bold">开源免费</td>
              </tr>
              <tr class="hover:bg-accent/20">
                <td class="py-3 px-3 font-bold text-foreground">OpenWrt PassWall</td>
                <td class="py-3 px-3 text-info">软路由 / Linux 网关</td>
                <td class="py-3 px-3 text-muted-foreground">C + Shell + LuCI 网页控制台</td>
                <td class="py-3 px-3 text-muted-foreground">全协议支持 + ChinaDNS-NG</td>
                <td class="py-3 px-3 text-success font-bold">透明代理 (iptables/nftables)</td>
                <td class="py-3 px-3 text-foreground font-bold">依赖路由器物理运存 (小巧)</td>
                <td class="py-3 px-3 text-primary">★★★ (需要固件刷机)</td>
                <td class="py-3 px-3 text-success font-bold">开源免费</td>
              </tr>
            </tbody>
          </table>
        </div>

        <p class="text-xs text-muted-foreground font-mono">
          * 数据说明：内存占用指标基于同等环境下挂载 50 个节点、持续维持 200 个并发长连接 30 分钟后的稳定工作集内存（Working Set Memory）取样实测，各客户端均已升级至 2026 年最新稳定版本。
        </p>
      </PixelPanel>
    </section>

    {/* ========================================================= */}
    {/* 3. 🧠 代理内核技术演进史：从 Clash 原版到 Mihomo 与 Sing-box */}
    {/* ========================================================= */}
    <section id="kernel-evolution" class="flex flex-col gap-4">
      <PixelPanel class="p-6 md:p-8 bg-card border-2 border-border flex flex-col gap-5">
        <h2 class="font-display text-lg text-foreground uppercase flex items-center gap-2">
          <span>🧠</span> 代理内核演进史：从 Clash 停更风波到 Mihomo (Meta) 的全面崛起
        </h2>

        <div class="text-xs font-mono text-muted-foreground leading-relaxed flex flex-col gap-4">
          <p>
            在深入掌握具体客户端配置之前，用户必须首先建立清晰的<strong>“内核（Core）”</strong>与<strong>“图形外壳（GUI）”</strong>分离的系统观。在现代科学上网软件体系中，图形界面软件（如 Clash Verge Rev、v2rayN）本质上只是负责绘制操作按钮、展示节点延迟波形和读写 YAML 配置文件的“交互外壳”；而真正驻留在操作系统后台、负责捕获网络原始数据包、执行复杂的加密握手、匹配千万级分流规则并调度多路复用隧道的，是位于底层的二进制可执行内核。
          </p>

          <div class="bg-background border-2 border-border p-4.5 flex flex-col gap-2.5">
            <span class="font-bold text-foreground text-sm">阶段一：Clash Premium 原版核心与其时代局限性 (2018 - 2023)</span>
            <p>
              在 2018 年之前，科学上网技术长期停留在 Shadowsocks 与 ShadowsocksR 的原始时期，用户只能在“全局代理”与“基于简单域名的 PAC 文本文件”之间二选一，无法应对复杂的企业级内网分流需求。Dreamacro 开发的 Clash 凭借革命性的<strong>“策略组（Proxy Groups）”</strong>与<strong>“规则分流引擎（Rule-based Routing）”</strong>设计，使代理软件首次具备了根据目标 IP 地理位置（GEOIP）、域名后缀（DOMAIN-SUFFIX）以及进程名自动切换不同出口节点的工业级能力。
            </p>
            <p>
              然而，随着作者在 2023 年底因不可抗力注销 GitHub 账号并清空仓库，原版 Clash 留下了巨大的技术债务：其封闭源码的 Premium 内核原生无法兼容 Xray 团队推出的 VLESS-Reality 协议，原生不支持基于 UDP 的 Hysteria 2 与 TUIC 协议，其早期编写的 TUN 虚拟网卡驱动在 Windows 11 的多次大版本更新后频繁出现休眠后断网和系统蓝屏等严重缺陷。
            </p>
          </div>

          <div class="bg-background border-2 border-border p-4.5 flex flex-col gap-2.5">
            <span class="font-bold text-success text-sm">阶段二：社区分叉救世主 —— Mihomo (原 Clash Meta) 的一统江湖 (2023 - 2026)</span>
            <p>
              在原版停更的危急关头，全球开源社区开发者迅速组建 MetaCubeX 组织，在原版开源代码基础上展开了浩大的重构重写工程，诞生了 <strong>Mihomo（最初命名为 Clash.Meta）</strong>。Mihomo 展现了惊人的工程迭代速度与高度包容的开源胸襟：
            </p>
            <ul class="list-disc list-inside flex flex-col gap-1.5 pl-2 text-foreground">
              <li><strong>协议大一统</strong>：全面合并吸收了 Xray 的 VLESS (Vision/Reality) 规范，并深度集成了新一代高速 UDP 协议 Hysteria 2、TUIC v5 以及 WireGuard 原生隧道；</li>
              <li><strong>内核级性能重构</strong>：彻底重写了内存池调度与垃圾回收逻辑，引入基于 mmap 内存映射的 GEO 规则解析引擎，使得数万条复杂规则的加载与匹配耗时从原版的 800ms 锐减至 30ms 以内，内存占用缩减 40% 以上；</li>
              <li><strong>现代化 TUN 虚拟网卡驱动</strong>：集成了与 Cloudflare 同源的最新一代 Wintun 驱动与系统级透明代理引擎，彻底解决了在 Windows 11 下休眠复苏断流的历史沉疴。</li>
            </ul>
            <p>
              截至 2026 年，Mihomo 已经成为整个中文代理软件生态中绝对的事实标准核心。无论是桌面端的 Clash Verge Rev、跨平台的 Flclash，还是路由器端的 ShellCrash，底层均统一基于 Mihomo 构建。
            </p>
          </div>

          <div class="bg-background border-2 border-border p-4.5 flex flex-col gap-2.5">
            <span class="font-bold text-info text-sm">阶段三：新一代独立通用架构颠覆者 —— Sing-box (2024 - 2026)</span>
            <p>
              与 Mihomo 选择在 Clash 架构上修修补补不同，由 SagerNet 核心团队打造的 <strong>Sing-box</strong> 走了一条彻底革新的技术路线。它完全抛弃了 Clash 的 YAML 语法与陈旧网络栈，采用现代 Go 语言进行全栈重写。
            </p>
            <p>
              Sing-box 最大的工程突破在于<strong>统一了客户端与服务端的逻辑抽象</strong>。它没有“客户端特有功能”与“服务端特有功能”的界限，入站（Inbounds）与出站（Outbounds）采用了极其纯粹的管道转发模型。这种架构使得 Sing-box 在软路由与嵌入式系统上展现了无与伦比的极致性能：内存消耗通常只有同级别 Clash 的一半，吞吐并发能力极其惊人。尽管其极其严苛复杂的 JSON 规则语法给普通小白用户设立了较高的门槛，但在追求极致性能与极客定制的资深玩家心目中，Sing-box 代表着代理软件架构的未来演进方向。
            </p>
          </div>

