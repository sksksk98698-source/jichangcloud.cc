---
import { Badge } from "@components/ui/badge";
import { PixelPanel } from "@components/ui/pixel-panel";

import { airportsData } from "@/data/airportsData";

// Top 10 airports
const top10 = airportsData.slice(0, 10);
---

<section id="airport-rankings" aria-labelledby="rankings-title" class="flex flex-col gap-6">
  <div
    class="border-border flex flex-col gap-2 border-b-4 pb-3 sm:flex-row sm:items-end sm:justify-between"
  >
    <div>
      <div class="flex items-center gap-2">
        <span class="font-display text-info text-xs uppercase">TOP RANKINGS</span>
        <Badge pixel variant="secondary">2026 最新榜单</Badge>
      </div>
      <h2
        id="rankings-title"
        class="font-display text-foreground mt-1 text-2xl tracking-tight uppercase md:text-3xl"
      >
        2026 精选梯子机场推荐 TOP 10
      </h2>
    </div>
    <a href="/airports/" class="text-success font-mono text-xs hover:underline">
      查看全部 42 家机场评测库 →
    </a>
  </div>

  <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
    {
      top10.map((item) => (
        <PixelPanel class="bg-card border-border hover:border-primary flex flex-col justify-between gap-4 border-2 p-5 transition-colors">
          <div class="flex flex-col gap-2">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2">
                <span
                  class={`font-display border-border flex size-7 items-center justify-center border-2 text-sm ${item.rank === 1 ? "bg-primary font-bold text-black" : item.rank <= 3 ? "bg-info font-bold text-black" : "bg-muted text-foreground"}`}
                >
                  {item.rank}
                </span>
                <h3 class="font-display text-foreground text-lg tracking-tight uppercase">
                  {item.name}
                </h3>
              </div>
              <span class="text-success font-mono text-sm font-bold">{item.price}</span>
            </div>

            <p class="text-muted-foreground line-clamp-2 text-xs">{item.summary}</p>

            <div class="flex flex-wrap items-center gap-1.5 pt-1">
              <span class="bg-accent/60 border-border text-foreground border px-1.5 py-0.5 font-mono text-[10px]">
                {item.lineType}
              </span>
              {item.protocols.map((proto) => (
                <span class="bg-background border-border text-muted-foreground border px-1.5 py-0.5 font-mono text-[10px]">
                  {proto}
                </span>
              ))}
              {item.hasSpeedtest && (
                <span class="bg-success/20 text-success border-success/40 border px-1.5 py-0.5 font-mono text-[10px]">
                  附带实测图
                </span>
              )}
              {item.coupon && (
                <span class="bg-primary/20 text-primary border-primary/40 border px-1.5 py-0.5 font-mono text-[10px]">
                  券: {item.coupon}
                </span>
              )}
            </div>
          </div>

          <div class="border-border/60 flex items-center gap-2 border-t pt-2">
            <a
              href={`/airports/${item.slug}/`}
              class="pixel-btn flex-1 px-3 py-2 text-center text-xs"
            >
              详情测评
            </a>
            <a
              href={item.registerUrl}
              target="_blank"
              rel="nofollow sponsored noopener"
              class="pixel-btn pixel-btn--blue flex-1 px-3 py-2 text-center text-xs"
            >
              直通官网 ↗
            </a>
          </div>
        </PixelPanel>
      ))
    }
  </div>

  <div class="bg-accent/30 border-border border-2 p-4 text-center">
    <p class="text-muted-foreground text-xs">
      需要更多轻量入门、按量付费或企业独享专线？访问
      <a href="/airports/" class="text-info mx-1 font-bold underline">全网 42 家机场品牌库</a>
      支持多维度协议与线路筛选。
    </p>
  </div>
</section>
