---
import HeroPanel from "@components/Sections/Global/HeroPanel.astro";
import {
  Breadcrumb,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbPage,
  BreadcrumbSeparator,
} from "@components/ui/breadcrumb";
import { PixelPanel } from "@components/ui/pixel-panel";
import BaseLayout from "@layouts/BaseLayout.astro";

import { faqArticles, faqCategories } from "@/data/faqData";

const pageTitle =
  "2026 科学上网与机场使用 100 问权威百科：排障自愈/节点超时/ChatGPT与DNS泄漏全解 — 机场cloud";
const pageDescription =
  "全网最详尽的翻墙故障自检与百科知识库。专为解决节点全部超时 (-1ms)、连得上但打不开网页、ChatGPT 1020 报错、Netflix 软封锁，到国内微信分流错配与 DNS 泄漏防御全解析。";

// 专著级结构化数据：WebPage + TechArticle + FAQPage
const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "TechArticle",
      headline: "2026 科学上网与机场使用疑难排障与知识百科全书",
      description: pageDescription,
      author: {
        "@type": "Organization",
        name: "机场cloud网络技术支持中心",
      },
      datePublished: "2026-01-18T08:00:00+08:00",
      dateModified: "2026-03-30T10:00:00+08:00",
      inLanguage: "zh-CN",
      mainEntityOfPage: "https://jichangcloud.cc/faq/",
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "节点全部测速超时（显示 -1ms 或 Timeout），为什么网页彻底打不开？",
          acceptedAnswer: {
            "@type": "Answer",
            text: "超过 80% 的全红超时案例是因为本地系统时钟与标准互联网授时中心误差超过 60 秒。由于现代代理协议（如 VMess、VLESS、Trojan）使用 TLS 1.3 双向加密认证，时间戳漂移会导致握手校验直接被服务端主动拒绝。进入操作系统日期与时间设置，点击立即同步网络时钟即可秒级恢复。若时间正常，则需检查订阅是否欠费过期或机场国内中继入口遭受攻击。",
          },
        },
        {
          "@type": "Question",
          name: "客户端显示连接成功且有流量产生，但浏览器就是打不开任何海外网站是怎么回事？",
          acceptedAnswer: {
            "@type": "Answer",
            text: "这是典型的“连得上但打不开网页”故障。诱因主要有三点：第一，操作系统系统代理开关未正确挂载，或被 Chrome/Edge 扩展（如 SwitchyOmega）覆写劫持；第二，DNS 解析黑洞，本地客户端未开启 DNS 劫持防护，导致国外域名被本地运营商 DNS 污染返回错误 IP；第三，若开启了 TUN 虚拟网卡模式，可能是本地存在多个虚拟网卡驱动（如 VirtualBox/VMware）导致路由表跳数（Metric）竞争死循环。",
          },
        },
        {
          "@type": "Question",
          name: "访问 ChatGPT 频繁提示 Access Denied 或 1020 报错，该如何彻底解决？",
          acceptedAnswer: {
            "@type": "Answer",
            text: "OpenAI 采用了极高等级的 Cloudflare Turnstile 与 IP 风险欺诈库风控。造成报错的核心原因：一是使用了 OpenAI 未开放服务的香港节点；二是当前节点 IP 被 Cloudflare 识别为数据中心机房 IDC 广播 IP，欺诈评分过高；三是浏览器缓存了此前的封禁 Cookie。解决方法：切换至新加坡、日本或美国的原生住宅 ISP 节点，打开浏览器无痕隐身窗口，并清空本地 DNS 缓存。",
          },
        },
        {
          "@type": "Question",
          name: "为什么开启代理后，国内微信、淘宝、网易云音乐打不开或提示异地登录风控？",
          acceptedAnswer: {
            "@type": "Answer",
            text: "这是因为误开启了“全局模式（Global）”。在全局模式下，包括微信、网易云在内的国内所有流量都被强制转发至海外代理节点，导致国内应用检测到海外异地登录触发安全风控，甚至因海外节点版权封锁导致国内音乐变灰。应在客户端将代理模式切换为“规则模式（Rule）”，依托 GeoIP 与 GeoSite 数据库实现国内流量本地直连，海外流量走代理。",
          },
        },
        {
          "@type": "Question",
          name: "什么是 DNS 泄漏？为什么开了翻墙后在 ipleak.net 依然能看到国内运营商 IP？",
          acceptedAnswer: {
            "@type": "Answer",
            text: "DNS 泄漏是指客户端在通过加密代理访问海外网站时，操作系统依然向本地 ISP 运营商默认的 53 端口 DNS 发送明文解析请求。这会导致国内运营商完整记录你访问的海外域名列表。解决方案是在 Clash 或 Sing-box 中配置 Fake-IP 模式，将本地 DNS 解析接管到虚拟保留网段（198.18.0.0/16），杜绝系统向公网直发任何未加密的明文 DNS 查询。",
          },
        },
        {
          "@type": "Question",
          name: "什么是节点倍率？为什么下载了一个 5GB 文件，机场后台却扣除了 15GB 流量？",
          acceptedAnswer: {
            "@type": "Answer",
            text: "节点倍率是机场服务商平衡专线成本的计费杠杆。例如 1.0x 倍率节点消耗 1GB 扣除 1GB 流量；而 3.0x 高倍率节点（通常为企业级物理 IEPL 专线或极速流媒体解锁节点）传输 1GB 实际扣除 3GB 流量；0.2x 低倍率节点传输 5GB 仅扣除 1GB 流量。用户在大流量下载文件或更新游戏前，应在节点列表优先选择 1.0x 或低倍率普通节点，追剧与办公再使用高倍率专线。",
          },
        },
        {
          "@type": "Question",
          name: "Windows 系统重启或关机后无法正常上网，网页全部提示“代理服务器连接被拒”怎么办？",
          acceptedAnswer: {
            "@type": "Answer",
            text: "这是因为电脑在未正常关闭代理客户端的情况下异常关机，导致 Windows 注册表中的“系统代理开关”依然处于开启状态，但本地代理监听端口（如 7890）随着客户端关闭已不复存在。解决方法：打开 Windows“网络和 Internet”设置，进入“代理”选项，将“使用代理服务器”手动关闭，或重新打开代理软件后在菜单栏正常点击“退出”即可。",
          },
        },
        {
          "@type": "Question",
          name: "Netflix 提示只能观看自制剧（软封锁），怎样才能解锁完整版权库？",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Netflix 实行区域版权库机制。当系统检测到用户的 IP 属于机房托管机（Hosting/Data Center）而非本地家庭宽带（ISP/Residential）时，会触发软封锁，仅允许观看 Netflix 拥有全球版权的自制剧（如怪奇物语），隐藏所有第三方版权电影。需要使用具备“原生住宅双 ISP 解锁”的专业节点，并在客户端确保流媒体域名走独立的分流策略组。",
          },
        },
        {
          "@type": "Question",
          name: "Clash 订阅导入时报错“Format Error”或“无法解析 YAML 配置文件”该如何修复？",
          acceptedAnswer: {
            "@type": "Answer",
            text: "诱因主要有两点：一是机场后端节点下发服务故障，订阅链接返回了 HTML 报错页面（如 502 Bad Gateway）而非标准的 YAML 文本；二是用户使用了不支持的旧版客户端，无法解析新语法（如 rule-providers 或 sniffing）。排查步骤：首先用浏览器打开订阅链接看是否返回一长串节点字符，若返回网页代码则联系机场客服；若正常，建议通过在线订阅转换工具转换为标准 Clash 配置。",
          },
        },
        {
          "@type": "Question",
          name: "为什么很多机场声称是“千兆专线”，但晚高峰实际测速只有十几兆且频繁卡顿？",
          acceptedAnswer: {
            "@type": "Answer",
            text: "许多不良或小作坊机场虽然购买了千兆公网服务器，但为了超额盈利，将 1Gbps 的带宽超量超卖给数千名用户。在晚高峰时段，带宽利用率达到 100% 极限过载，导致严重排队拥塞；或者其本质是“假专线”，走的是普通公网国际出口，遭受了电信 163 骨干网的晚高峰 QoS 强制丢包。选择深耕多年的正规 IEPL 专线机场（如光速云）才能保证全天候物理独享带宽与低延迟。",
          },
        },
      ],
    },
  ],
};
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(schemaData)} />

  <div class="site-container text-foreground flex flex-col gap-10 py-8 md:gap-12 md:py-12">
    {/* 面包屑导航 */}
    <Breadcrumb class="font-mono text-xs">
      <BreadcrumbItem><BreadcrumbLink href="/">首页</BreadcrumbLink></BreadcrumbItem>
      <BreadcrumbSeparator />
      <BreadcrumbItem><BreadcrumbPage>机场使用百科 FAQ</BreadcrumbPage></BreadcrumbItem>
    </Breadcrumb>

    {/* 万字级 Pillar 顶部看板 */}
    <HeroPanel
      headingId="faq-heading"
      tagline="TROUBLESHOOTING & KNOWLEDGE BASE"
      heading="2026 科学上网与机场使用 100 问权威百科"
      intro="收割全网翻墙长尾痛点。专为解决‘连得上但打不开网页’、‘节点瞬间全红’、‘ChatGPT 报错 1020’等疑难杂症，采用标准排查流程，手把手带你 30 秒自检恢复。"
    />

    {/* ⚡ Answer Block 极速首答 */}
    <PixelPanel
      class="bg-card border-primary/80 shadow-pixel flex flex-col gap-5 border-4 p-6 md:p-8"
    >
      <div class="border-border flex items-center gap-2 border-b pb-3">
        <span class="text-primary text-xl">⚡</span>
        <h2 class="font-display text-foreground text-lg tracking-tight uppercase">
          Answer Block：三大最高频翻墙故障黄金秒级自愈法
        </h2>
      </div>

      <div class="grid grid-cols-1 gap-5 font-mono text-xs leading-relaxed md:grid-cols-3">
        <div class="bg-background border-border flex flex-col gap-3 border-2 p-4">
          <span class="text-primary flex items-center gap-1.5 text-sm font-bold">
            <span>🔴</span> 节点全部超时 (-1ms / Timeout)
          </span>
          <p class="text-muted-foreground">
            80% 是因为<strong>本地电脑时钟误差超过 60 秒</strong>导致 TLS
            加密握手被拒！进入系统“日期和时间”设置，关闭再开启“自动设置时间”同步授时即可秒级修复。若时钟正常，检查订阅流量是否耗尽或机场主中继入口遭到网络封锁。
          </p>
        </div>

        <div class="bg-background border-border flex flex-col gap-3 border-2 p-4">
          <span class="text-info flex items-center gap-1.5 text-sm font-bold">
            <span>🤖</span> ChatGPT 提示 Access Denied / 1020
          </span>
          <p class="text-muted-foreground">
            当前节点 IP 被 OpenAI 标记为机房 IDC 或使用了未开放服务的香港节点。立即在客户端<strong
              >切换为新加坡/日本/美国原生住宅 ISP 节点</strong
            >，在浏览器开启无痕隐私窗口重新进入，即可彻底跳过 Cloudflare 拦截墙。
          </p>
        </div>

        <div class="bg-background border-border flex flex-col gap-3 border-2 p-4">
          <span class="text-success flex items-center gap-1.5 text-sm font-bold">
            <span>🟢</span> 国内微信/淘宝/网易云打不开
          </span>
          <p class="text-muted-foreground">
            误开启了“全局模式 (Global)”！立即将代理客户端切换回<strong>“规则模式 (Rule)”</strong
            >，让国内流量自动直连走本地宽带，海外走高速专线；并在设置中核实 GeoIP
            规则库已更新至最新版本。
          </p>
        </div>
      </div>

      <div
        class="bg-accent/20 border-border/80 flex flex-col items-center justify-between gap-3 rounded border p-4 font-mono text-xs md:flex-row"
      >
        <span class="text-muted-foreground">
          <strong class="text-foreground">知识库排查手册更新：</strong> 2026 年 3 月版 | <strong
            >技术审核：</strong
          > 机场cloud NOC 运维团队 | <strong>实测覆盖环境：</strong> Windows / macOS / iOS / Android /
          Linux
        </span>
        <a href="#matrix-table" class="text-primary shrink-0 font-bold hover:underline">
          直接跳转下文详细排障决策对照表 ↓
        </a>
      </div>
    </PixelPanel>

    {/* 4 大核心分类指标展示栏 */}
    <div class="grid grid-cols-2 gap-3 font-mono text-xs md:grid-cols-4">
      {
        faqCategories
          .filter((c) => c.id !== "all")
          .map((cat) => (
            <a
              href={`#cat-${cat.id}`}
              class="bg-background border-border hover:border-primary flex flex-col gap-1 border-2 p-3.5 transition-colors"
            >
              <span class="text-foreground flex items-center justify-between font-bold">
                {cat.name}
                <span class="text-primary">→</span>
              </span>
              <span class="text-muted-foreground text-[11px]">收录 {cat.count} 篇深度排查指南</span>
            </a>
          ))
      }
    </div>

    {/* 目录快速导航导航栏 TOC */}
    <PixelPanel class="bg-card border-border border-2 p-5 font-mono text-xs">
      <div class="text-foreground mb-3 flex items-center gap-2 font-bold tracking-wider uppercase">
        <span class="text-primary">📑</span> 故障自愈与知识百科目录索引（点击快速跳转）
      </div>
      <div class="text-muted-foreground grid grid-cols-1 gap-2 sm:grid-cols-2 md:grid-cols-3">
        <a href="#matrix-table" class="hover:text-primary transition-colors"
          >1. 核心排障决策矩阵与黄金处理对照表</a
        >
        <a href="#module-network-timeout" class="hover:text-primary transition-colors"
          >2. 网络连接与节点超时（-1ms/全红深度排障）</a
        >
        <a href="#module-ai-streaming" class="hover:text-primary transition-colors"
          >3. ChatGPT / OpenAI 与 Netflix 流媒体受限</a
        >
        <a href="#module-dns-leak" class="hover:text-primary transition-colors"
          >4. DNS 污染、DNS 泄漏与 Fake-IP 核心原理</a
        >
        <a href="#module-routing-rules" class="hover:text-primary transition-colors"
          >5. 代理规则分流错配与国内应用打不开</a
        >
        <a href="#module-client-system" class="hover:text-primary transition-colors"
          >6. 客户端内核崩溃、TUN 网卡与系统兼容性</a
        >
        <a href="#module-subscription-billing" class="hover:text-primary transition-colors"
          >7. 机场订阅导入报错、账单计费与倍率陷阱</a
        >
        <a href="#module-sop-flowchart" class="hover:text-primary transition-colors"
          >8. 标准 5 步黄金排障 SOP 决策树</a
        >
        <a href="#module-faq-deep" class="hover:text-primary transition-colors"
          >9. 机场使用 10 大核心疑难权威 FAQ</a
        >
        <a href="#module-recommendation" class="hover:text-primary transition-colors"
          >10. 生产力破局：零故障物理专线机场推荐</a
        >
      </div>
    </PixelPanel>

    {/* 模块一：核心排障决策矩阵对照表 */}
    <div id="matrix-table" class="flex flex-col gap-4">
      <div class="border-primary border-l-4 pl-3">
        <h2 class="font-display text-foreground text-xl tracking-tight uppercase">
          一、2026 常见网络代理故障自检与排障决策矩阵对照表
        </h2>
        <p class="text-muted-foreground mt-1 font-mono text-xs">
          将全网高发报错场景抽象为可量化指标，帮助用户在 30 秒内精准定位故障层级与修复动作。
        </p>
      </div>

      <PixelPanel class="bg-card border-border flex flex-col gap-5 border-2 p-6">
        <div class="overflow-x-auto">
          <table class="w-full min-w-[780px] border-collapse text-left font-mono text-xs">
            <thead>
              <tr class="border-border text-muted-foreground bg-accent/30 border-b-2">
                <th class="px-3 py-3">故障症状表象</th>
                <th class="px-3 py-3">底层故障根因</th>
                <th class="px-3 py-3">影响协议层级</th>
                <th class="px-3 py-3">判断特征与速查方法</th>
                <th class="px-3 py-3">修复预估耗时</th>
                <th class="px-3 py-3">标准修复动作 / 操作命令</th>
              </tr>
            </thead>
            <tbody class="divide-border/60 divide-y">
              <tr class="hover:bg-accent/20">
                <td class="text-destructive px-3 py-3 font-bold">节点测速全部超时 (-1ms)</td>
                <td class="text-foreground px-3 py-3">系统时钟偏离超过 60s 或中继入口阻断</td>
                <td class="text-info px-3 py-3 font-bold">Layer 4 TLS / TCP</td>
                <td class="text-muted-foreground px-3 py-3"
                  >客户端日志提示 Certificate Date Invalid</td
                >
                <td class="text-success px-3 py-3 font-bold">15 秒</td>
                <td class="text-foreground px-3 py-3 font-bold"
                  >系统设置同步 Internet 授时，重置 NTP</td
                >
              </tr>
              <tr class="hover:bg-accent/20">
                <td class="text-warning px-3 py-3 font-bold">连得上但网页打不开</td>
                <td class="text-foreground px-3 py-3">系统代理端口未监听或 DNS 53 端口黑洞</td>
                <td class="text-info px-3 py-3 font-bold">Layer 7 HTTP / DNS</td>
                <td class="text-muted-foreground px-3 py-3"
                  >Telegram 能发消息，Chrome 提示 DNS_PROBE</td
                >
                <td class="text-success px-3 py-3 font-bold">30 秒</td>
                <td class="text-foreground px-3 py-3 font-bold"
                  >重置系统代理，切换为 Fake-IP 模式并清理缓存</td
                >
              </tr>
              <tr class="hover:bg-accent/20">
                <td class="text-info px-3 py-3 font-bold">ChatGPT Access Denied</td>
                <td class="text-foreground px-3 py-3">IP 属于机房 IDC 或命中 Cloudflare 高风险</td>
                <td class="text-info px-3 py-3 font-bold">Layer 7 欺诈分控</td>
                <td class="text-muted-foreground px-3 py-3"
                  >页面报错 1020 / Ray ID 拦截 / 香港 IP</td
                >
                <td class="text-success px-3 py-3 font-bold">20 秒</td>
                <td class="text-foreground px-3 py-3 font-bold"
                  >切换至美/日原生住宅双 ISP 节点，开无痕窗口</td
                >
              </tr>
              <tr class="hover:bg-accent/20">
                <td class="text-warning px-3 py-3 font-bold">微信/淘宝/网易云打不开</td>
                <td class="text-foreground px-3 py-3">误开启全局模式导致国内流量绕行海外</td>
                <td class="text-info px-3 py-3 font-bold">Layer 3 路由策略</td>
                <td class="text-muted-foreground px-3 py-3"
                  >国内 APP 提示网络异常，网易云音乐变灰</td
                >
                <td class="text-success px-3 py-3 font-bold">10 秒</td>
                <td class="text-foreground px-3 py-3 font-bold"
                  >客户端模式从 Global 切换为 Rule 规则分流</td
                >
              </tr>
